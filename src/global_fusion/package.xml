<?xml version="1.0"?>
<package format="3">
  <name>global_fusion</name>
  <version>1.0.0</version>
  <description>GPS and visual inertial global fusion for ROS 2 Jazzy.</description>
  <maintainer email="qintonguav@gmail.com">VINS-Fusion maintainers</maintainer>
  <license>GPL-3.0-only</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>vins_common</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>eigen</depend>
  <depend>ceres-solver</depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
